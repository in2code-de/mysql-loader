{
  "name": "co-stack/mysql-loader",
  "description": "Handle MySQL LOAD DATA and SELECT INTO OUTFILE using doctrine/dbal",
  "license": "BSD-3-Clause",
  "type": "library",
  "keywords": [
    "mysql",
    "dump",
    "export",
    "load",
    "outfile",
    "file import",
    "sqldump"
  ],
  "authors": [
    {
      "name": "Oliver Eglseder",
      "email": "oliver.eglseder@co-stack.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "CoStack\\MysqlLoader\\": "src"
    }
  },
  "bin": [
    "bin/mysql-loader"
  ],
  "require": {
    "php": "^8.1",
    "ext-zip": "*",
    "co-stack/lib": "^v5.1 || ^v6.0 || ^v7.0 || ^v8.0",
    "doctrine/dbal": "^3.0",
    "symfony/console": "^v5.4 || ^v6.3 || ^v7.2",
    "symfony/dependency-injection": "^v5.4 || ^v6.3 || ^v7.2",
    "symfony/config": "^v5.4 || ^v6.3 || ^v7.2",
    "co-stack/build-essentials": "@dev"
  },
  "require-dev": {
    "symfony/yaml": "^v5.4 || ^v6.4 || ^v7.2"
  },
  "config": {
    "allow-plugins": {
      "co-stack/build-essentials": true
    }
  },
  "extra": {
    "co-stack/build-essentials": {
      "resource": "config/services.yaml"
    }
  }
}
